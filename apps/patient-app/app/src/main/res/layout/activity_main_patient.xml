<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_dark">

    <!-- حاوية شاشات المريض -->
    <FrameLayout
        android:id="@+id/patientFragmentContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/patientBottomNav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- شريط التنقل السفلي الفاخر مع مؤشرات التحديد التفاعلية -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/patientBottomNav"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:background="@drawable/bg_patient_bottom_nav"
        app:elevation="12dp"
        app:menu="@menu/bottom_nav_patient"
        app:itemIconTint="@color/bottom_nav_item_selector"
        app:itemTextColor="@color/bottom_nav_item_selector"
        app:itemActiveIndicatorStyle="@style/Widget.MedicalClinic.BottomNav.ActiveIndicator"
        
        app:itemTextAppearanceActive="@style/Widget.MedicalClinic.BottomNav.ActiveText"
        app:itemTextAppearanceInactive="@style/Widget.MedicalClinic.BottomNav.InactiveText"
        app:itemRippleColor="@color/brand_primary_soft"
        app:labelVisibilityMode="labeled"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- فقاعة الذكاء الاصطناعي العائمة المدمجة المتوهجة -->
    <FrameLayout
        android:id="@+id/fabAiBubble"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:clickable="true"
        android:focusable="true"
        android:elevation="14dp"
        app:layout_constraintBottom_toTopOf="@id/patientBottomNav"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp">

        <!-- هالة التوهج الخارجية الناعمة -->
        <View
            android:id="@+id/vBubbleGlowHalo"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_circle_bubble_glow" />

        <androidx.cardview.widget.CardView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="center"
            app:cardCornerRadius="22dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="#0F766E">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_header_gradient_teal">

                <ImageView
                    android:id="@+id/ivBubbleIcon"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_doctor_robot"
                    android:contentDescription="روبوت طبيب" />

                <!-- نقطة نبض خضراء ذكية في الزاوية -->
                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_gravity="top|end"
                    android:layout_margin="3dp"
                    android:background="@drawable/bg_badge_red_circle"
                    android:backgroundTint="#34D399" />
            </FrameLayout>
        </androidx.cardview.widget.CardView>
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
