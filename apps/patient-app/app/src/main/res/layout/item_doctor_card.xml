<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="2.5dp"
    android:layout_marginBottom="3.5dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="1.5dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/brand_stroke_alpha"
    app:cardBackgroundColor="@color/surface_dark_elevated">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_card_3d_glass"
        android:padding="10dp">

        <!-- صورة الطبيب مع الإطار الأنيق المتناسق -->
        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_avatar_doctor_ring">

            <TextView
                android:id="@+id/tvDoctorEmoji"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="👨‍⚕️"
                android:textSize="22sp" />

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivDoctorAvatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:visibility="gone"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />
        </FrameLayout>

        <!-- بيانات الطبيب المنسقة والمتناسقة هندسياً -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingEnd="8dp">

            <!-- الاسم والتقييم في سطر واحد لتوفير المساحة وتوازن البطاقة -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvDoctorName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="د. أحمد خالد"
                    android:textColor="@color/on_surface_dark"
                    android:textSize="14.5sp"
                    android:textStyle="bold"
                    android:singleLine="true"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/tvDoctorRating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" • ⭐ 4.9"
                    android:textColor="@color/gold_star"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvDoctorSpecialty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="استشاري طب وجراحة العيون"
                android:textColor="@color/brand_primary"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end"
                android:layout_marginTop="1dp" />

            <TextView
                android:id="@+id/tvDoctorClinic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="مستشفى الأمل - صنعاء"
                android:textColor="@color/on_surface_dark_secondary"
                android:textSize="10.5sp"
                android:singleLine="true"
                android:ellipsize="end"
                android:layout_marginTop="1dp" />

            <TextView
                android:id="@+id/tvDoctorSeats"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🟢 متبقي 8 مقاعد متاحة"
                android:textColor="@color/brand_success"
                android:textSize="10sp"
                android:textStyle="bold"
                android:background="@drawable/bg_pill_status_confirmed"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:layout_marginTop="3dp" />
        </LinearLayout>

        <!-- السعر وزر الحجز المدمج -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end|center_vertical">

            <TextView
                android:id="@+id/tvDoctorFee"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="5,000 ر.ي"
                android:textColor="@color/brand_primary"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:background="@drawable/bg_tab_pill_inactive"
                android:backgroundTint="@color/brand_primary_soft"
                android:paddingStart="7dp"
                android:paddingEnd="7dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBookDoctor"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginTop="4dp"
                android:text="حجز كشف ❯"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:cornerRadius="9dp"
                app:elevation="1dp"
                app:backgroundTint="@color/brand_primary"
                android:paddingStart="9dp"
                android:paddingEnd="9dp" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>