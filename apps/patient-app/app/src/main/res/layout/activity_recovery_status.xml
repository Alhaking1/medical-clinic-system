<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <!-- أيقونة الحالة -->
        <FrameLayout
            android:id="@+id/statusIconContainer"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_marginTop="40dp"
            android:background="@drawable/bg_circle_primary"
            android:elevation="12dp">

            <TextView
                android:id="@+id/tvStatusIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="⏳"
                android:textSize="60sp" />
        </FrameLayout>

        <!-- العنوان -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="طلبك قيد المراجعة"
            android:textColor="@color/on_surface_dark"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- الحالة -->
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:background="@drawable/bg_status_badge"
            android:text="⏳ قيد المراجعة"
            android:textColor="@color/brand_secondary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- الاسم -->
        <TextView
            android:id="@+id/tvUserName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text=""
            android:textColor="@color/on_surface_dark"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- التفاصيل -->
        <TextView
            android:id="@+id/tvDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:lineSpacingExtra="6dp"
            android:text="سيتم مراجعة طلبك من قبل الإدارة.\nسيتم التواصل معك قريبًا."
            android:textColor="@color/on_surface_dark_secondary"
            android:textSize="14sp" />

        <!-- ملاحظة الرفض (تظهر فقط عند الرفض) -->
        <TextView
            android:id="@+id/tvRejectionReason"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:padding="16dp"
            android:background="@drawable/bg_input_field"
            android:gravity="center"
            android:text=""
            android:textColor="@color/on_surface_dark"
            android:textSize="14sp"
            android:visibility="gone" />

        <!-- Progress -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:visibility="gone" />

        <!-- زر تحديث الحالة -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRefresh"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="32dp"
            android:text="🔄 تحديث الحالة"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="16dp"
            app:backgroundTint="@color/brand_secondary" />

        <!-- زر تعيين كلمة مرور جديدة (يظهر فقط عند الموافقة) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnResetPassword"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:text="🔐 تعيين كلمة مرور جديدة"
            android:textSize="16sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:cornerRadius="16dp"
            app:backgroundTint="@color/brand_primary" />

        <!-- زر إلغاء الطلب والمحاولة مجددًا (يظهر عند الرفض) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRetry"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:text="↩️ المحاولة مجددًا"
            android:textSize="16sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:cornerRadius="16dp"
            app:strokeColor="@color/brand_secondary"
            app:strokeWidth="2dp"
            app:backgroundTint="@android:color/transparent"
            android:textColor="@color/brand_secondary" />

        <!-- ملاحظة سفلية -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:gravity="center"
            android:text="يمكنك إغلاق التطبيق والعودة لاحقًا.\nسيتم الاحتفاظ بطلبك حتى المراجعة."
            android:textColor="@color/on_surface_dark_tertiary"
            android:textSize="12sp"
            android:lineSpacingExtra="4dp" />

    </LinearLayout>
</ScrollView>