<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <!-- زر الرجوع -->
        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="start"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back"
            android:rotation="180"
            android:contentDescription="Back"
            app:tint="@color/on_surface_dark_secondary" />

        <!-- أيقونة -->
        <FrameLayout
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_marginTop="30dp"
            android:background="@drawable/bg_circle_primary"
            android:elevation="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="🔑"
                android:textSize="50sp" />
        </FrameLayout>

        <!-- العنوان -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="التحقق من الهوية"
            android:textColor="@color/on_surface_dark"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDisplayName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text=""
            android:textColor="@color/brand_secondary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="أدخل كلمة المرور القديمة للتحقق من هويتك"
            android:textColor="@color/on_surface_dark_secondary"
            android:textSize="14sp" />

        <!-- كلمة المرور -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            app:endIconMode="password_toggle"
            app:endIconTint="@color/on_surface_dark_tertiary"
            app:boxBackgroundMode="none"
            app:hintEnabled="false"
            app:errorEnabled="true">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etOldPassword"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:hint="كلمة المرور القديمة"
                android:textColorHint="@color/on_surface_dark_tertiary"
                android:textColor="@color/on_surface_dark"
                android:textSize="15sp"
                android:inputType="textPassword"
                android:background="@drawable/bg_input_field"
                android:paddingStart="16dp"
                android:paddingEnd="48dp"
                android:singleLine="true" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- ملاحظة: الحساب Google -->
        <TextView
            android:id="@+id/tvGoogleNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:padding="16dp"
            android:background="@drawable/bg_input_field"
            android:gravity="center"
            android:text="هذا الحساب مسجل باستخدام Google.\nلا تحتاج كلمة مرور — اضغط متابعة."
            android:textColor="@color/on_surface_dark_secondary"
            android:textSize="13sp"
            android:lineSpacingExtra="4dp"
            android:visibility="gone" />

        <!-- الاسم الكامل (اختياري — للمراجعة) -->
        <EditText
            android:id="@+id/etFullName"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:hint="الاسم الكامل (اختياري — للمراجعة)"
            android:textColorHint="@color/on_surface_dark_tertiary"
            android:textColor="@color/on_surface_dark"
            android:textSize="15sp"
            android:inputType="textPersonName"
            android:background="@drawable/bg_input_field"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:singleLine="true"
            android:visibility="gone" />

        <!-- زر المتابعة -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVerify"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="20dp"
            android:text="🔓 تحقق وتعيين كلمة مرور جديدة"
            android:textSize="15sp"
            android:textStyle="bold"
            app:cornerRadius="16dp"
            app:backgroundTint="@color/brand_secondary" />

        <!-- Progress -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:visibility="gone" />

        <!-- رسالة -->
        <TextView
            android:id="@+id/tvResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text=""
            android:textSize="14sp"
            android:visibility="gone" />

        <!-- Hint -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:gravity="center"
            android:text="إذا نسيت كلمة المرور القديمة، أدخل اسمك الكامل بدقة\nوسيتم إرسال الطلب للأدمن للمراجعة."
            android:textColor="@color/on_surface_dark_tertiary"
            android:textSize="12sp"
            android:lineSpacingExtra="4dp" />

    </LinearLayout>
</ScrollView>