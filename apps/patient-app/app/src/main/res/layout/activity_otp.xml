<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_screen"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="28dp"
        android:layoutDirection="rtl">

        <!-- Header Circle Badge -->
        <FrameLayout
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:layout_marginTop="36dp"
            android:background="@drawable/bg_circle_soft_teal"
            android:elevation="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="📲"
                android:textSize="40sp" />
        </FrameLayout>

        <!-- Title -->
        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/otp_title"
            android:textColor="@color/on_surface_dark"
            android:textSize="26sp"
            android:textStyle="bold" />

        <!-- Subtitle -->
        <TextView
            android:id="@+id/subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:text="@string/otp_subtitle"
            android:textColor="@color/on_surface_dark_secondary"
            android:textSize="14sp" />

        <!-- Verification Code Input Box -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="3dp"
            app:strokeWidth="1.5dp"
            app:strokeColor="#330D9488"
            app:cardBackgroundColor="@color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="أدخل الرمز المكون من 6 أرقام"
                    android:textColor="#64748B"
                    android:textSize="12sp"
                    android:layout_marginBottom="8dp" />

                <EditText
                    android:id="@+id/otpEdit"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:hint="• • • • • •"
                    android:textColorHint="#94A3B8"
                    android:textColor="#0F172A"
                    android:inputType="number"
                    android:maxLength="6"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.25"
                    android:gravity="center"
                    android:background="@drawable/bg_input_field_luxury"
                    android:paddingHorizontal="16dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Verify Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/verifyButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="24dp"
            android:text="@string/otp_button"
            android:textColor="#FFFFFF"
            android:textSize="15.5sp"
            android:textStyle="bold"
            app:cornerRadius="16dp"
            app:backgroundTint="@color/brand_primary"
            android:elevation="4dp" />

        <!-- Resend Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/resendButton"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:text="@string/otp_resend"
            android:textColor="@color/brand_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            app:cornerRadius="16dp"
            app:strokeColor="@color/brand_primary"
            app:strokeWidth="1.5dp" />

        <!-- Security Note -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="🛡️ منظومة التحقق المشفرة والآمنة 100%"
            android:textColor="#94A3B8"
            android:textSize="11.5sp" />

    </LinearLayout>
</ScrollView>
