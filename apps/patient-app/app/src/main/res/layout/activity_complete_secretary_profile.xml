<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- الأيقونة -->
        <FrameLayout
            android:id="@+id/iconContainer"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_circle_secondary"
            android:elevation="12dp"
            android:layout_marginTop="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="👩‍💼"
                android:textSize="44sp" />

        </FrameLayout>

        <!-- العنوان -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="إكمال بيانات السكرتيرة"
            android:textColor="@color/on_surface_dark"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginTop="20dp"
            android:layout_gravity="center" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="أدخل بياناتك وأضف عيادتك"
            android:textColor="@color/on_surface_dark_secondary"
            android:textSize="13sp"
            android:layout_marginTop="6dp"
            android:layout_gravity="center" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="32dp" />

        <!-- الاسم الكامل -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="* الاسم الكامل"
            android:textColor="@color/on_surface_dark_secondary"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etFullName"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="مثال: أحمد محمد علي"
            android:textColorHint="@color/on_surface_dark_tertiary"
            android:textColor="@color/on_surface_dark"
            android:textSize="15sp"
            android:inputType="textPersonName"
            android:background="@drawable/bg_input_field"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:singleLine="true" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="20dp" />

        <!-- الهاتف -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="* رقم الهاتف"
            android:textColor="@color/on_surface_dark_secondary"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etPhone"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="7XXXXXXXX"
            android:textColorHint="@color/on_surface_dark_tertiary"
            android:textColor="@color/on_surface_dark"
            android:textSize="16sp"
            android:inputType="number"
            android:maxLength="9"
            android:background="@drawable/bg_input_field"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:singleLine="true"
            android:digits="0123456789" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="24dp" />

        <!-- كلمة المرور -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="* كلمة المرور (للدخول لاحقاً)"
            android:textColor="@color/on_surface_dark_secondary"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etPassword"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="6 أحرف على الأقل"
            android:textColorHint="@color/on_surface_dark_tertiary"
            android:textColor="@color/on_surface_dark"
            android:textSize="16sp"
            android:inputType="textPassword"
            android:background="@drawable/bg_input_field"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:singleLine="true" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="24dp" />

        <!-- اختيار الوضع -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="* هل ستُنشئ عيادة جديدة أم تنضم لعيادة موجودة؟"
            android:textColor="@color/on_surface_dark_secondary"
            android:textSize="14sp"
            android:layout_marginBottom="12dp" />

        <RadioGroup
            android:id="@+id/rgClinicMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/rbCreateClinic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🆕 إنشاء عيادة جديدة"
                android:textColor="@color/on_surface_dark"
                android:textSize="15sp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:checked="true" />

            <RadioButton
                android:id="@+id/rbJoinClinic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🔗 الانضمام لعيادة موجودة"
                android:textColor="@color/on_surface_dark"
                android:textSize="15sp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp" />
        </RadioGroup>

        <Space
            android:layout_width="match_parent"
            android:layout_height="16dp" />

        <!-- إنشاء عيادة -->
        <LinearLayout
            android:id="@+id/layoutCreateClinic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="* اسم العيادة"
                android:textColor="@color/on_surface_dark_secondary"
                android:textSize="14sp"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/etClinicName"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:hint="عيادة النور"
                android:textColorHint="@color/on_surface_dark_tertiary"
                android:textColor="@color/on_surface_dark"
                android:textSize="15sp"
                android:inputType="text"
                android:background="@drawable/bg_input_field"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:singleLine="true" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="* المحافظة"
                android:textColor="@color/on_surface_dark_secondary"
                android:textSize="14sp"
                android:layout_marginBottom="8dp" />

            <Spinner
                android:id="@+id/spGovernorate"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                style="@style/AppSpinner"
                android:paddingStart="16dp"
                android:paddingEnd="16dp" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="العنوان"
                android:textColor="@color/on_surface_dark_secondary"
                android:textSize="14sp"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/etAddress"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:hint="الشارع، الحي"
                android:textColorHint="@color/on_surface_dark_tertiary"
                android:textColor="@color/on_surface_dark"
                android:textSize="15sp"
                android:inputType="text"
                android:background="@drawable/bg_input_field"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:singleLine="true" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="رابط خريطة Google"
                android:textColor="@color/on_surface_dark_secondary"
                android:textSize="14sp"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/etMapsUrl"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:hint="https://maps.google.com/..."
                android:textColorHint="@color/on_surface_dark_tertiary"
                android:textColor="@color/on_surface_dark"
                android:textSize="14sp"
                android:inputType="textUri"
                android:background="@drawable/bg_input_field"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:singleLine="true" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ملاحظات"
                android:textColor="@color/on_surface_dark_secondary"
                android:textSize="14sp"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/etNotes"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:hint="أي ملاحظات..."
                android:textColorHint="@color/on_surface_dark_tertiary"
                android:textColor="@color/on_surface_dark"
                android:textSize="14sp"
                android:background="@drawable/bg_input_field"
                android:padding="16dp"
                android:inputType="textMultiLine"
                android:gravity="top" />

        </LinearLayout>

        <!-- الانضمام لعيادة -->
        <LinearLayout
            android:id="@+id/layoutJoinClinic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="* اختر العيادة"
                android:textColor="@color/on_surface_dark_secondary"
                android:textSize="14sp"
                android:layout_marginBottom="8dp" />

            <Spinner
                android:id="@+id/spClinics"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                style="@style/AppSpinner"
                android:paddingStart="16dp"
                android:paddingEnd="16dp" />

            <TextView
                android:id="@+id/tvClinicsError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/brand_danger"
                android:textSize="13sp"
                android:layout_marginTop="8dp"
                android:visibility="gone" />

        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="32dp" />

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="حفظ البيانات"
            android:textSize="17sp"
            android:textStyle="bold"
            app:cornerRadius="16dp"
            app:backgroundTint="@color/brand_secondary" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="24dp" />

    </LinearLayout>
</ScrollView>