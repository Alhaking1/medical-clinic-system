<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:layoutDirection="rtl">

    <!-- Header Banner -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#ECFDF5"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="#D1FAE5"
            android:gravity="center"
            android:text="👨‍👩‍👧"
            android:textSize="18sp"
            android:layout_marginEnd="10dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="إضافة فرد عائلة للحساب"
                android:textColor="#065F46"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="يمكنك حجز المواعيد ومتابعة السجل الطبي لهم بسهولة"
                android:textColor="#047857"
                android:textSize="11.5sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Patient Name Input -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="الاسم الكامل للمريض (فرد العائلة) *"
        android:textColor="#1F2937"
        android:textSize="13sp"
        android:textStyle="bold"
        android:layout_marginBottom="6dp" />

    <EditText
        android:id="@+id/etFamilyName"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@drawable/bg_input_field_luxury"
        android:hint="مثال: أحمد محمد علي"
        android:textColor="#111827"
        android:textColorHint="#9CA3AF"
        android:textSize="14sp"
        android:paddingHorizontal="16dp"
        android:inputType="textPersonName"
        android:layout_marginBottom="14dp" />

    <!-- Relationship Spinner -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="صلة القرابة *"
        android:textColor="#1F2937"
        android:textSize="13sp"
        android:textStyle="bold"
        android:layout_marginBottom="6dp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@drawable/bg_input_field_luxury"
        android:layout_marginBottom="14dp">

        <Spinner
            android:id="@+id/spFamilyRelation"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingHorizontal="14dp"
            android:background="@android:color/transparent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="14dp"
            android:text="▼"
            android:textColor="#6B7280"
            android:textSize="11sp" />
    </FrameLayout>

    <!-- Age and Gender Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="6dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="العمر (بالسنوات)"
                android:textColor="#1F2937"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/etFamilyAge"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/bg_input_field_luxury"
                android:hint="مثال: 7"
                android:textColor="#111827"
                android:textColorHint="#9CA3AF"
                android:textSize="14sp"
                android:paddingHorizontal="16dp"
                android:inputType="number" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.2"
            android:orientation="vertical"
            android:layout_marginEnd="6dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="الجنس"
                android:textColor="#1F2937"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <RadioGroup
                android:id="@+id/rgFamilyGender"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/bg_input_field_luxury"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="8dp">

                <RadioButton
                    android:id="@+id/rbGenderMale"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ذكر"
                    android:textSize="13sp"
                    android:textColor="#374151"
                    android:checked="true"
                    android:layout_marginStart="8dp" />

                <RadioButton
                    android:id="@+id/rbGenderFemale"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="أنثى"
                    android:textSize="13sp"
                    android:textColor="#374151"
                    android:layout_marginStart="14dp" />
            </RadioGroup>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
