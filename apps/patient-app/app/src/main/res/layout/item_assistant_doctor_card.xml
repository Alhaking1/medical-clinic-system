<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="10dp">

        <ImageView
            android:id="@+id/ivDocCardAvatar"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_circle_primary"
            android:backgroundTint="#E0F2F1"
            android:src="@drawable/ic_nav_profile"
            app:tint="#00897B"
            android:padding="8dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="10dp">

            <TextView
                android:id="@+id/tvDocCardName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="د. أحمد محمد"
                android:textColor="#1E293B"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDocCardClinic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="عيادة النور • 4,500 ر.ي"
                android:textColor="#64748B"
                android:textSize="11sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBookDocCard"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="احجز الآن ❯"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            app:backgroundTint="#00897B"
            app:cornerRadius="8dp"
            android:paddingHorizontal="10dp"
            android:insetTop="0dp"
            android:insetBottom="0dp" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
