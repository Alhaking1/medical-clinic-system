<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="235dp"
    android:layout_height="wrap_content"
    android:layout_marginStart="6dp"
    android:layout_marginEnd="6dp"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="18dp"
    app:cardElevation="2dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/border_field"
    app:cardBackgroundColor="@color/surface_dark_elevated">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- صورة المستشفى العلوية مع شارة الحالة -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="95dp"
            android:background="@color/brand_primary_soft">

            <ImageView
                android:id="@+id/ivHospitalImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/bg_card_offers_teal" />

            <TextView
                android:id="@+id/tvHospitalEmoji"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="🏥"
                android:textSize="34sp" />

            <!-- شارة الحالة في الزاوية -->
            <TextView
                android:id="@+id/tvHospitalStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_margin="8dp"
                android:background="@drawable/bg_tab_pill_inactive"
                android:backgroundTint="@color/surface_dark_elevated"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:text="🟢 مفتوح الآن"
                android:textColor="@color/brand_primary"
                android:textSize="10.5sp"
                android:textStyle="bold" />
        </FrameLayout>

        <!-- تفاصيل المستشفى -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/tvHospitalName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="مستشفى السلام"
                android:textColor="@color/on_surface_dark"
                android:textSize="15sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <!-- الموقع والشارع -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="4dp">

                <ImageView
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:src="@drawable/ic_location_pin"
                    app:tint="@color/brand_primary" />

                <TextView
                    android:id="@+id/tvHospitalCity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="عدن - خورمكسر"
                    android:textColor="@color/on_surface_dark_secondary"
                    android:textSize="11.5sp"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>

            <!-- ساعات العمل -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="3dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🕒"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/tvHospitalWorkingHours"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="من 08:00 ص إلى 10:00 م"
                    android:textColor="@color/on_surface_dark_tertiary"
                    android:textSize="10.5sp" />
            </LinearLayout>

            <!-- زر الحجز والتفاصيل الفاخر الموحد -->
            <TextView
                android:id="@+id/tvHospitalSpecialtiesCount"
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_tab_pill_active"
                android:gravity="center"
                android:text="حجز كشف عيادة ❯"
                android:textColor="#FFFFFF"
                android:textSize="11.5sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
