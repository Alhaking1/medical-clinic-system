<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="3dp"
    android:layout_marginBottom="4dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="1.5dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/brand_stroke_alpha"
    app:cardBackgroundColor="@color/surface_dark_elevated">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="10dp">

        <!-- Shimmer Avatar Placeholder -->
        <View
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_circle_primary"
            android:backgroundTint="@color/shimmer_element" />

        <!-- Shimmer Text Placeholders -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingEnd="8dp">

            <!-- Doctor Name Placeholder -->
            <View
                android:layout_width="130dp"
                android:layout_height="14dp"
                android:background="@drawable/bg_tab_pill_active"
                android:backgroundTint="@color/shimmer_element" />

            <!-- Specialty Placeholder -->
            <View
                android:layout_width="90dp"
                android:layout_height="11dp"
                android:layout_marginTop="5dp"
                android:background="@drawable/bg_tab_pill_active"
                android:backgroundTint="@color/shimmer_element" />

            <!-- Seats Pill Placeholder -->
            <View
                android:layout_width="75dp"
                android:layout_height="14dp"
                android:layout_marginTop="5dp"
                android:background="@drawable/bg_pill_queue_number"
                android:backgroundTint="@color/shimmer_element" />
        </LinearLayout>

        <!-- Shimmer Button Placeholder -->
        <View
            android:layout_width="60dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_btn_book_teal"
            android:backgroundTint="@color/shimmer_element" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>