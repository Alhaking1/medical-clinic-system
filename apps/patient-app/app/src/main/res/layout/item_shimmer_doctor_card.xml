<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="2dp"
    app:strokeWidth="1dp"
    app:strokeColor="#E2E8F0"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp">

        <!-- Shimmer Avatar Placeholder -->
        <View
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_circle_primary"
            android:backgroundTint="#E2E8F0" />

        <!-- Shimmer Text Placeholders -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <!-- Doctor Name Placeholder -->
            <View
                android:layout_width="140dp"
                android:layout_height="16dp"
                android:background="@drawable/bg_tab_pill_active"
                android:backgroundTint="#E2E8F0" />

            <!-- Specialty Placeholder -->
            <View
                android:layout_width="100dp"
                android:layout_height="12dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_tab_pill_active"
                android:backgroundTint="#F1F5F9" />

            <!-- Seats Pill Placeholder -->
            <View
                android:layout_width="80dp"
                android:layout_height="18dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_pill_queue_number"
                android:backgroundTint="#F1F5F9" />
        </LinearLayout>

        <!-- Shimmer Button Placeholder -->
        <View
            android:layout_width="72dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_btn_book_teal"
            android:backgroundTint="#E2E8F0" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
