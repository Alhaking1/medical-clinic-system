<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="24dp"
    app:cardElevation="12dp"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="26dp"
        android:gravity="center_horizontal"
        android:layoutDirection="rtl">

        <!-- Animated / Soft Badge Circle -->
        <FrameLayout
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:background="@drawable/bg_circle_soft_teal"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="👋"
                android:textSize="32sp" />
        </FrameLayout>

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="مرحباً بك في طبيبك!"
            android:textColor="#0F172A"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Subtitle -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:text="أكمل بياناتك الصحية لتسهيل حجز المواعيد والحصول على تجربة استشارية متكاملة"
            android:textColor="#64748B"
            android:textSize="13.5sp" />

        <!-- Complete Now Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCompleteNow"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="24dp"
            android:text="✏️ إكمال البيانات الآن"
            android:textColor="@color/white"
            android:textSize="14.5sp"
            android:textStyle="bold"
            app:cornerRadius="14dp"
            app:backgroundTint="@color/brand_primary" />

        <!-- Later Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLater"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:text="⏭️ تذكيري لاحقاً"
            android:textColor="#64748B"
            android:textSize="14sp"
            app:cornerRadius="14dp"
            app:strokeColor="#CBD5E1"
            app:strokeWidth="1dp" />

    </LinearLayout>
</androidx.cardview.widget.CardView>
