<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8FAFC"
    android:layoutDirection="rtl">

    <!-- Header Toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#00897B"
        android:paddingHorizontal="16dp"
        android:elevation="4dp">

        <ImageButton
            android:id="@+id/btnBackAssistant"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back"
            app:tint="#FFFFFF"
            android:contentDescription="رجوع" />

        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="6dp"
                android:background="@drawable/bg_circle_primary"
                android:backgroundTint="#FFFFFF"
                android:src="@drawable/ic_doctor_robot"
                android:contentDescription="روبوت طبيب" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="المساعد الطبي ومرشد التطبيق 🤖"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🟢 متصل الآن • توجيه سريري معتمد 24/7"
                android:textColor="#CCFBF1"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Chat Messages List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvAssistantMessages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:padding="12dp"
        android:scrollbars="vertical" />

    <!-- Thinking Indicator -->
    <LinearLayout
        android:id="@+id/layoutThinking"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:background="#E0F2F1"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:indeterminateTint="#00897B" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="المساعد يحلل الأعراض ويبحث عن أنسب الأطباء..."
            android:textColor="#00695C"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Quick Suggestions Horizontal Scroll -->
    <HorizontalScrollView
        android:id="@+id/scrollSuggestions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:background="#F1F5F9">

        <LinearLayout
            android:id="@+id/layoutSuggestions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chipEmergency"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_status_upcoming"
                android:backgroundTint="#FEE2E2"
                android:textColor="#B91C1C"
                android:textSize="12sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:lines="1"
                android:paddingHorizontal="14dp"
                android:paddingVertical="7dp"
                android:text="🚨 علامات الطوارئ"
                android:layout_marginStart="6dp" />

            <TextView
                android:id="@+id/chipGoldenSeat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_status_upcoming"
                android:backgroundTint="#FEF3C7"
                android:textColor="#92400E"
                android:textSize="12sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:lines="1"
                android:paddingHorizontal="14dp"
                android:paddingVertical="7dp"
                android:text="👑 ما هو الحجز الذهبي؟"
                android:layout_marginStart="6dp" />

            <TextView
                android:id="@+id/chipFamilyBooking"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_status_upcoming"
                android:backgroundTint="#EFF6FF"
                android:textColor="#1D4ED8"
                android:textSize="12sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:lines="1"
                android:paddingHorizontal="14dp"
                android:paddingVertical="7dp"
                android:text="👨‍👩‍👧‍👦 حجز لأحد أفراد العائلة"
                android:layout_marginStart="6dp" />

            <TextView
                android:id="@+id/chipNfcArrival"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_status_upcoming"
                android:backgroundTint="#DCFCE7"
                android:textColor="#15803D"
                android:textSize="12sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:lines="1"
                android:paddingHorizontal="14dp"
                android:paddingVertical="7dp"
                android:text="📍 تأكيد الحضور بـ NFC"
                android:layout_marginStart="6dp" />

            <TextView
                android:id="@+id/chipWalletRecharge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_status_upcoming"
                android:backgroundTint="#F3E8FF"
                android:textColor="#7E22CE"
                android:textSize="12sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:lines="1"
                android:paddingHorizontal="14dp"
                android:paddingVertical="7dp"
                android:text="💳 شحن رصيد المحفظة"
                android:layout_marginStart="6dp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Bottom Input Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="10dp"
        android:background="#FFFFFF"
        android:elevation="8dp">

        <EditText
            android:id="@+id/etAssistantInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="46dp"
            android:maxHeight="110dp"
            android:background="@drawable/bg_input_field"
            android:hint="صف أعراضك أو اسأل عن ميزات التطبيق..."
            android:textColor="#1E293B"
            android:textColorHint="#94A3B8"
            android:textSize="14sp"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp"
            android:inputType="textMultiLine" />

        <ImageButton
            android:id="@+id/btnSendAssistant"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_circle_primary"
            android:backgroundTint="#00897B"
            android:src="@drawable/ic_send"
            app:tint="#FFFFFF"
            android:contentDescription="إرسال" />
    </LinearLayout>
</LinearLayout>
