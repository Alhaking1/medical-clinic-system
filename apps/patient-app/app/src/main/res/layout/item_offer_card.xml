<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/surface_dark_elevated">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- رأس بطاقة العرض: شارة الخصم والتاريخ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvOfferDiscountBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_circle_primary"
                android:backgroundTint="@color/danger_soft"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:text="خصم 40% 🔥"
                android:textColor="@color/brand_danger"
                android:textSize="12sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvOfferExpiry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⏳ متاح لفترة محدودة"
                android:textColor="@color/on_surface_dark_tertiary"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- عنوان العرض والوصف -->
        <TextView
            android:id="@+id/tvOfferTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="باقة فحص النظر والقرنية الشامل"
            android:textColor="@color/on_surface_dark"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="12dp" />

        <TextView
            android:id="@+id/tvOfferDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="فحص كامل لضغط العين وحدة الإبصار وتصوير قاع العين بأحدث الأجهزة."
            android:textColor="@color/on_surface_dark_secondary"
            android:textSize="12sp"
            android:layout_marginTop="6dp"
            android:lineSpacingExtra="2dp" />

        <!-- بيانات الطبيب والعيادة -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="10dp"
            android:padding="8dp"
            android:background="@drawable/bg_input_field">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="👨‍⚕️ "
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvOfferDoctorInfo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="د. منى حسن (عيون) • مستشفى الأمل"
                android:textColor="@color/on_surface_dark"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp" />

        <!-- السعر وزر الحجز -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvOfferOriginalPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="10,000 ر.ي"
                    android:textColor="@color/on_surface_dark_disabled"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvOfferDiscountedPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="6,000 ر.ي"
                    android:textColor="@color/brand_primary_dark"
                    android:textSize="17sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBookOffer"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:text="حجز العرض الآن"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                app:cornerRadius="12dp"
                app:backgroundTint="@color/brand_primary"
                android:paddingStart="16dp"
                android:paddingEnd="16dp" />
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>
