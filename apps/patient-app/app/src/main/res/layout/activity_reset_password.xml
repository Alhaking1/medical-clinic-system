<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_screen"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp"
        android:layoutDirection="rtl">

        <!-- أيقونة فاخرة -->
        <FrameLayout
            android:layout_width="92dp"
            android:layout_height="92dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_circle_soft_teal"
            android:elevation="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="🔐"
                android:textSize="44sp" />
        </FrameLayout>

        <!-- العنوان -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="تعيين كلمة مرور جديدة"
            android:textColor="@color/on_surface_dark"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="اختر كلمة مرور قوية ومطابقة للمعايير الأمنية لحسابك"
            android:textColor="@color/on_surface_dark_secondary"
            android:textSize="13.5sp" />

        <!-- بطاقة الحقول الفاخرة -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardCornerRadius="22dp"
            app:cardElevation="3dp"
            app:strokeWidth="1dp"
            app:strokeColor="#E2E8F0"
            app:cardBackgroundColor="@color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- كلمة المرور الجديدة -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="كلمة المرور الجديدة *"
                    android:textColor="#1E293B"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:endIconMode="password_toggle"
                    app:endIconTint="#64748B"
                    app:boxBackgroundMode="none"
                    app:hintEnabled="false"
                    app:errorEnabled="false">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPassword"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:hint="أدخل كلمة المرور الجديدة"
                        android:textColorHint="#94A3B8"
                        android:textColor="#0F172A"
                        android:textSize="14sp"
                        android:inputType="textPassword"
                        android:background="@drawable/bg_input_field_luxury"
                        android:paddingHorizontal="16dp"
                        android:singleLine="true" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- تأكيد كلمة المرور -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="تأكيد كلمة المرور *"
                    android:textColor="#1E293B"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="6dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilConfirmPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:endIconMode="password_toggle"
                    app:endIconTint="#64748B"
                    app:boxBackgroundMode="none"
                    app:hintEnabled="false"
                    app:errorEnabled="false">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etConfirmPassword"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:hint="أعد كتابة كلمة المرور"
                        android:textColorHint="#94A3B8"
                        android:textColor="#0F172A"
                        android:textSize="14sp"
                        android:inputType="textPassword"
                        android:background="@drawable/bg_input_field_luxury"
                        android:paddingHorizontal="16dp"
                        android:singleLine="true" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- قائمة شروط الأمان -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="vertical"
                    android:background="#F8FAFC"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/tvReqLength"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="3dp"
                        android:text="⬜ 8 أحرف على الأقل"
                        android:textColor="#64748B"
                        android:textSize="12.5sp" />

                    <TextView
                        android:id="@+id/tvReqUpper"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="3dp"
                        android:text="⬜ حرف كبير (A-Z)"
                        android:textColor="#64748B"
                        android:textSize="12.5sp" />

                    <TextView
                        android:id="@+id/tvReqLower"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="3dp"
                        android:text="⬜ حرف صغير (a-z)"
                        android:textColor="#64748B"
                        android:textSize="12.5sp" />

                    <TextView
                        android:id="@+id/tvReqNumber"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="3dp"
                        android:text="⬜ رقم واحد على الأقل"
                        android:textColor="#64748B"
                        android:textSize="12.5sp" />

                    <TextView
                        android:id="@+id/tvReqMatch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="3dp"
                        android:text="⬜ كلمتا المرور متطابقتان"
                        android:textColor="#64748B"
                        android:textSize="12.5sp" />
                </LinearLayout>

                <!-- زر تعيين كلمة المرور -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnReset"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="20dp"
                    android:text="🔐 حفظ كلمة المرور الجديدة"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:cornerRadius="14dp"
                    app:backgroundTint="@color/brand_primary" />

                <!-- Progress -->
                <ProgressBar
                    android:id="@+id/progressBar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="16dp"
                    android:indeterminateTint="@color/brand_primary"
                    android:visibility="gone" />

                <!-- رسالة النتيجة -->
                <TextView
                    android:id="@+id/tvResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:textSize="13.5sp"
                    android:visibility="gone" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
