<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <!-- أيقونة -->
        <FrameLayout
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_marginTop="30dp"
            android:background="@drawable/bg_circle_primary"
            android:elevation="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="🔐"
                android:textSize="50sp" />
        </FrameLayout>

        <!-- العنوان -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="تعيين كلمة مرور جديدة"
            android:textColor="@color/on_surface_dark"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="اختر كلمة مرور قوية لحسابك"
            android:textColor="@color/on_surface_dark_secondary"
            android:textSize="14sp" />

        <!-- كلمة المرور الجديدة -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            app:endIconMode="password_toggle"
            app:endIconTint="@color/on_surface_dark_tertiary"
            app:boxBackgroundMode="none"
            app:hintEnabled="false"
            app:errorEnabled="true">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:hint="كلمة المرور الجديدة"
                android:textColorHint="@color/on_surface_dark_tertiary"
                android:textColor="@color/on_surface_dark"
                android:textSize="15sp"
                android:inputType="textPassword"
                android:background="@drawable/bg_input_field"
                android:paddingStart="16dp"
                android:paddingEnd="48dp"
                android:singleLine="true" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- تأكيد كلمة المرور -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilConfirmPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:endIconMode="password_toggle"
            app:endIconTint="@color/on_surface_dark_tertiary"
            app:boxBackgroundMode="none"
            app:hintEnabled="false"
            app:errorEnabled="true">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etConfirmPassword"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:hint="تأكيد كلمة المرور"
                android:textColorHint="@color/on_surface_dark_tertiary"
                android:textColor="@color/on_surface_dark"
                android:textSize="15sp"
                android:inputType="textPassword"
                android:background="@drawable/bg_input_field"
                android:paddingStart="16dp"
                android:paddingEnd="48dp"
                android:singleLine="true" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- قائمة المتطلبات -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/tvReqLength"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="4dp"
                android:text="⬜ 8 أحرف على الأقل"
                android:textColor="@color/on_surface_dark_tertiary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvReqUpper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="4dp"
                android:text="⬜ حرف كبير (A-Z)"
                android:textColor="@color/on_surface_dark_tertiary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvReqLower"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="4dp"
                android:text="⬜ حرف صغير (a-z)"
                android:textColor="@color/on_surface_dark_tertiary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvReqNumber"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="4dp"
                android:text="⬜ رقم واحد على الأقل"
                android:textColor="@color/on_surface_dark_tertiary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvReqMatch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="4dp"
                android:text="⬜ كلمتا المرور متطابقتان"
                android:textColor="@color/on_surface_dark_tertiary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- زر تعيين كلمة المرور -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnReset"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:text="🔐 تعيين كلمة المرور"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="16dp"
            app:backgroundTint="@color/brand_secondary" />

        <!-- Progress -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:visibility="gone" />

        <!-- رسالة النتيجة -->
        <TextView
            android:id="@+id/tvResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text=""
            android:textSize="14sp"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>