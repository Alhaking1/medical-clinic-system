<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet_dialog"
    android:backgroundTint="@color/surface_dark"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:background="@color/divider"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="بطاقة الحجز والدور"
        android:textColor="@color/on_surface_dark"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvTicketBookingCode"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="رمز الحجز: #TAB-1042"
        android:textColor="@color/brand_primary"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginTop="4dp" />

    <!-- QR Code Card -->
    <androidx.cardview.widget.CardView
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        app:cardCornerRadius="22dp"
        app:cardElevation="6dp"
        app:cardBackgroundColor="@color/surface_dark_elevated">

        <ImageView
            android:id="@+id/ivTicketQr"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp"
            android:contentDescription="QR Code" />
    </androidx.cardview.widget.CardView>

    <!-- Details -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_input_field"
        android:backgroundTint="@color/surface_dark_elevated"
        android:padding="16dp"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="الطبيب:"
                android:textColor="@color/on_surface_dark_tertiary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvTicketDoctor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="د. محمد العمري"
                android:textColor="@color/on_surface_dark"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="العيادة / المستشفى:"
                android:textColor="@color/on_surface_dark_tertiary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvTicketClinic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="مستشفى الأمل"
                android:textColor="@color/on_surface_dark"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="الموعد:"
                android:textColor="@color/on_surface_dark_tertiary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvTicketTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2026-10-10 | 10:00 ص"
                android:textColor="@color/on_surface_dark"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="رقم الدور في العيادة:"
                android:textColor="@color/on_surface_dark_tertiary"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvTicketQueue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="#3"
                    android:textColor="#0D9488"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_pill_status_upcoming"
                    android:backgroundTint="#CCFBF1"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="4dp" />

                <TextView
                    android:id="@+id/tvTicketGoldenBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@color/banner_warning_bg"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:text="👑 حجز ذهبي"
                    android:textColor="@color/banner_warning_text"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutTicketTx"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:visibility="gone">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="رقم الحوالة:"
                android:textColor="@color/on_surface_dark_tertiary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvTicketTxId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="—"
                android:textColor="@color/brand_primary"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- أزرار تفاصيل الحجز: موقع العيادة على خرائط قوقل -->
    
    <!-- Live Queue Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardLiveQueue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:strokeWidth="1dp"
        app:strokeColor="#CBD5E1"
        app:cardBackgroundColor="#F8FAFC"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🚦"
                android:textSize="18sp"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/tvLiveQueueStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="جاري تتبع الدور اللحظي..."
                android:textSize="13sp"
                android:textColor="#334155"
                android:textStyle="bold" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDialogClinicMap"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="موقع العيادة 📍"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/brand_primary"
            app:cornerRadius="12dp"
            app:strokeColor="@color/brand_primary"
            app:strokeWidth="1.5dp"
            app:backgroundTint="@color/brand_primary_soft" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCopyBookingCode"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="نسخ الرمز 📋"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/brand_primary_dark"
            app:cornerRadius="12dp"
            app:strokeColor="@color/divider"
            app:strokeWidth="1dp"
            app:backgroundTint="@color/surface_dark_elevated" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnTicketClose"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="إغلاق تفاصيل الحجز"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        app:cornerRadius="12dp"
        app:backgroundTint="@color/brand_primary" />

</LinearLayout>
