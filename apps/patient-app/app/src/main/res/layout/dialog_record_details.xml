<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="24dp"
    app:cardElevation="12dp"
    app:cardBackgroundColor="@color/white">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="580dp"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:layoutDirection="rtl">

            <!-- Handle Bar -->
            <View
                android:layout_width="40dp"
                android:layout_height="4dp"
                android:background="#E2E8F0"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="14dp" />

            <!-- Header Badge & Logo -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#ECFDF5"
                android:padding="12dp"
                android:layout_marginBottom="14dp">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_tabeebak_logo"
                    android:contentDescription="Logo" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="روشتة وتقرير طبي موثق"
                        android:textColor="#065F46"
                        android:textSize="15.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvModalRecordCode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="كود التقرير: #REC-8841"
                        android:textColor="#0D9488"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="معتمد ✅"
                    android:textColor="#047857"
                    android:textSize="11.5sp"
                    android:textStyle="bold"
                    android:background="#D1FAE5"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp" />
            </LinearLayout>

            <!-- Doctor & Date Meta Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#F8FAFC"
                android:padding="12dp"
                android:layout_marginBottom="14dp">

                <TextView
                    android:id="@+id/tvModalRecordDoctor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="الطبيب المعالج: د. أحمد خالد الشرعبي"
                    android:textColor="#0F172A"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvModalRecordDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="تاريخ الكشف: 2026-10-12"
                    android:textColor="#64748B"
                    android:textSize="12sp"
                    android:layout_marginTop="3dp" />
            </LinearLayout>

            <!-- 1. Diagnosis Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🩺"
                    android:textSize="14sp"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="التشخيص الطبي السريري:"
                    android:textColor="#0F172A"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvModalDiagnosis"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#F1F5F9"
                android:padding="12dp"
                android:text="التهاب ملتحمة حاد وحساسية موسمية مصحوبة بجفاف خفيف"
                android:textColor="#1E293B"
                android:textSize="13sp"
                android:lineSpacingExtra="3dp"
                android:layout_marginBottom="12dp" />

            <!-- 2. Prescription Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💊"
                    android:textSize="14sp"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="الأدوية والجرعات (الروشتة):"
                    android:textColor="#0F172A"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvModalPrescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#F0FDF4"
                android:padding="12dp"
                android:text="1. قطرة Systane Ultra: قطرة 3 مرات يومياً\n2. مرهم Tobradex للعين: قبل النوم لمدة 5 أيام"
                android:textColor="#065F46"
                android:textSize="13sp"
                android:textStyle="bold"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="12dp" />

            <!-- 3. Lab Tests Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔬"
                    android:textSize="14sp"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="الفحوصات المخبرية المطلوبة:"
                    android:textColor="#0F172A"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvModalLabTests"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#F8FAFC"
                android:padding="12dp"
                android:text="لا توجد فحوصات مخبرية مطلوبة حالياً"
                android:textColor="#475569"
                android:textSize="13sp"
                android:lineSpacingExtra="3dp"
                android:layout_marginBottom="12dp" />

            <!-- 4. Notes / Instructions -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💡"
                    android:textSize="14sp"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="إرشادات الطبيب للمريض:"
                    android:textColor="#0F172A"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvModalNotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FEFCE8"
                android:padding="12dp"
                android:text="تجنب فرك العين والابتعاد عن الغبار وأشعة الشمس المباشرة"
                android:textColor="#854D0E"
                android:textSize="13sp"
                android:lineSpacingExtra="3dp"
                android:layout_marginBottom="16dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnModalClose"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="إغلاق التقرير"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                app:cornerRadius="14dp"
                app:backgroundTint="@color/brand_primary" />

        </LinearLayout>
    </ScrollView>
</androidx.cardview.widget.CardView>
