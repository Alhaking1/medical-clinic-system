<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="24dp"
    app:cardElevation="10dp"
    app:cardBackgroundColor="@color/surface_dark_elevated">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="⭐ تقييم الزيارة والخدمة الطبية"
                android:textColor="@color/on_surface_dark"
                android:textSize="17sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/ivCloseReview"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:tint="#64748B"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="4dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvReviewSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="رأيك يساعدنا في تحسين جودة الرعاية والخدمات لجميع المرضى"
            android:textColor="@color/on_surface_dark_secondary"
            android:textSize="12sp" />
        <!-- Verified Visit Trust Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#ECFDF5"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:layout_marginTop="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🛡️"
                android:textSize="14sp"
                android:layout_marginEnd="6dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="تقييم معتمد: تم التحقق من زيارتك وحضورك الفعلي للعيادة ✅"
                android:textColor="#047857"
                android:textSize="11.5sp"
                android:textStyle="bold" />
        </LinearLayout>


        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:background="@color/divider" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxHeight="420dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- 1. المستشفى / العيادة -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@color/surface_dark"
                    android:padding="10dp"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="🏥 المستشفى / العيادة"
                        android:textColor="@color/on_surface_dark"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <RatingBar
                        android:id="@+id/rbRatingHospital"
                        style="?android:attr/ratingBarStyleSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:numStars="5"
                        android:stepSize="1"
                        android:rating="5"
                        android:progressTint="@color/gold_star"
                        android:secondaryProgressTint="@color/gold_star"
                        android:isIndicator="false" />
                </LinearLayout>

                <!-- 2. الطبيب المعالج -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@color/surface_dark"
                    android:padding="10dp"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="👨‍⚕️ الطبيب المعالج"
                        android:textColor="@color/on_surface_dark"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <RatingBar
                        android:id="@+id/rbRatingDoctor"
                        style="?android:attr/ratingBarStyleSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:numStars="5"
                        android:stepSize="1"
                        android:rating="5"
                        android:progressTint="@color/gold_star"
                        android:secondaryProgressTint="@color/gold_star"
                        android:isIndicator="false" />
                </LinearLayout>

                <!-- 3. السكرتيرة والاستقبال -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@color/surface_dark"
                    android:padding="10dp"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="👩‍💼 السكرتيرة والاستقبال"
                        android:textColor="@color/on_surface_dark"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <RatingBar
                        android:id="@+id/rbRatingSecretary"
                        style="?android:attr/ratingBarStyleSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:numStars="5"
                        android:stepSize="1"
                        android:rating="5"
                        android:progressTint="@color/gold_star"
                        android:secondaryProgressTint="@color/gold_star"
                        android:isIndicator="false" />
                </LinearLayout>

                <!-- 4. مستوى الخدمة العامة -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@color/surface_dark"
                    android:padding="10dp"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="✨ الخدمة العامة والتنظيم"
                        android:textColor="@color/on_surface_dark"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <RatingBar
                        android:id="@+id/rbRatingService"
                        style="?android:attr/ratingBarStyleSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:numStars="5"
                        android:stepSize="1"
                        android:rating="5"
                        android:progressTint="@color/gold_star"
                        android:secondaryProgressTint="@color/gold_star"
                        android:isIndicator="false" />
                </LinearLayout>

                <!-- تعليق اختياري -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ملاحظات أو تعليق (اختياري):"
                    android:textColor="#475569"
                    android:textSize="12sp"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/etReviewComment"
                    android:layout_width="match_parent"
                    android:layout_height="70dp"
                    android:gravity="top|start"
                    android:hint="اكتب رأيك أو مقترحاتك هنا..."
                    android:textColorHint="@color/on_surface_dark_disabled"
                    android:textColor="@color/on_surface_dark"
                    android:textSize="13sp"
                    android:background="@drawable/bg_input_field"
                    android:padding="10dp" />

            </LinearLayout>
        </ScrollView>

        <!-- أزرار الإجراء -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelReview"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="إلغاء"
                android:textColor="@color/on_surface_dark_secondary"
                android:textSize="13sp"
                app:cornerRadius="12dp"
                app:strokeColor="@color/divider"
                app:strokeWidth="1dp"
                app:backgroundTint="#F8FAFC" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSubmitReview"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="2"
                android:layout_marginStart="6dp"
                android:text="إرسال التقييم ⭐"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                app:backgroundTint="@color/brand_primary" />
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>
