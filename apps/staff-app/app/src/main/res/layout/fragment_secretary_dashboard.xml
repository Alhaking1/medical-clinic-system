<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/swipeRefreshDashboard"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:background="@drawable/bg_gradient_screen">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="32dp">

        <!-- 1st Card: Clinic Appointments & Confirmations Section (حجوزات ومواعيد العيادة) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardAppointmentsSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            app:strokeWidth="1.5dp"
            app:strokeColor="#330D9488"
            app:cardBackgroundColor="@color/surface_dark_elevated">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <FrameLayout
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_circle_primary_soft">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_clipboard_check"
                            app:tint="#0A5C5F" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="حجوزات ومواعيد العيادة"
                            android:textColor="@color/on_surface_dark"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="متابعة وتأكيد حجوزات المرضى بالعيادة"
                            android:textColor="@color/on_surface_dark_tertiary"
                            android:textSize="12sp"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvAppointmentsCountBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:background="@drawable/bg_status_accepted"
                        android:textColor="@color/brand_primary"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:text="0 حجز" />
                </LinearLayout>

                <!-- Status Filter Chips Bar -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none"
                    android:layout_marginTop="12dp">

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupAppointmentFilter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:singleSelection="true"
                        app:selectionRequired="true">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipFilterAll"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="الكل" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipFilterUpcoming"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="القادمة ⏳" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipFilterCompleted"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="منتهية / مكتملة 🟢" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipFilterPast"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="السابقة 📅" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipFilterNoShow"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="لم يحضر 🚫" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipFilterCancelled"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ملغي ❌" />

                    </com.google.android.material.chip.ChipGroup>
                </HorizontalScrollView>

                <!-- Dynamic container for appointments -->
                <LinearLayout
                    android:id="@+id/layoutAppointmentsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="10dp" />

                <TextView
                    android:id="@+id/tvNoAppointments"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="لا توجد حجوزات مسجلة حالياً"
                    android:textColor="@color/on_surface_dark_tertiary"
                    android:textSize="13sp"
                    android:gravity="center"
                    android:padding="12dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Quick Walk-in Patient Registration Card (Collapsible) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardToggleWalkIn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="24dp"
            app:cardElevation="4dp"
            app:strokeWidth="1.5dp"
            app:strokeColor="#330D9488"
            app:cardBackgroundColor="@color/surface_dark_elevated"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:id="@+id/layoutToggleWalkInHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/tvWalkInHeaderIcon"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_circle_primary_soft"
                        android:gravity="center"
                        android:text="+"
                        android:textColor="@color/brand_primary"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="14dp">

                        <TextView
                            android:id="@+id/tvWalkInHeaderTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="تسجيل مريض حاضر بالعيادة (بدون حجز مسبق)"
                            android:textColor="@color/on_surface_dark"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvWalkInHeaderSubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="انقر هنا لإظهار نموذج تسجيل المريض مباشرة 🔽"
                            android:textColor="@color/brand_primary"
                            android:textSize="11sp"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvWalkInToggleArrow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="فتح ❯"
                        android:textColor="@color/brand_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Collapsible Form Container (Initially Hidden) -->
                <LinearLayout
                    android:id="@+id/layoutWalkInForm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:layout_marginTop="16dp">

                    <!-- Patient Name Input -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilWalkInName"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="اسم المريض"
                        app:boxCornerRadiusBottomEnd="14dp"
                        app:boxCornerRadiusBottomStart="14dp"
                        app:boxCornerRadiusTopEnd="14dp"
                        app:boxCornerRadiusTopStart="14dp"
                        android:layout_marginBottom="12dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etWalkInName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPersonName"
                            android:maxLength="25"
                            android:textColor="@color/on_surface_dark" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Patient Phone Input -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilWalkInPhone"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="رقم هاتف المريض"
                        app:boxCornerRadiusBottomEnd="14dp"
                        app:boxCornerRadiusBottomStart="14dp"
                        app:boxCornerRadiusTopEnd="14dp"
                        app:boxCornerRadiusTopStart="14dp"
                        android:layout_marginBottom="14dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etWalkInPhone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:digits="0123456789"
                            android:maxLength="9"
                            android:textColor="@color/on_surface_dark" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Doctor Selection Spinner -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="اختيار الطبيب المعالج:"
                        android:textColor="@color/on_surface_dark_secondary"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp" />

                    <Spinner
                        android:id="@+id/spWalkInDoctor"
                        style="@style/StaffSpinner.Dropdown"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginBottom="16dp" />

                    <!-- Add to Queue Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAddWalkInToQueue"
                        style="@style/Widget.MedicalClinicStaff.PrimaryButton"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/button_height"
                        android:text="إدراج المريض الحاضر في الطابور 📥" />

                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Summary Cards -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="نظرة عامة على العيادة"
            android:textColor="@color/on_surface_dark"
            android:textSize="17sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:cardCornerRadius="18dp"
                app:cardElevation="3dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/divider"
                app:cardBackgroundColor="@color/surface_dark_elevated"
                android:layout_marginEnd="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <FrameLayout
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_circle_primary_soft">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_users_group"
                            app:tint="#0A5C5F" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvSecDocCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="@color/brand_primary"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:layout_marginTop="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="أطباء العيادة"
                        android:textColor="@color/on_surface_dark_tertiary"
                        android:textSize="12sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:cardCornerRadius="18dp"
                app:cardElevation="3dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/divider"
                app:cardBackgroundColor="@color/surface_dark_elevated"
                android:layout_marginStart="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <FrameLayout
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_circle_primary_soft"
                        android:backgroundTint="#FEF9C3">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_tag_offer"
                            app:tint="#D4AF37" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvSecOffersCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="@color/gold_star"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:layout_marginTop="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="عروض نشطة"
                        android:textColor="@color/on_surface_dark_tertiary"
                        android:textSize="12sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>





        <!-- 2nd Card: Clinic Working Hours & Recurring Schedule Template Card (مواعيد وساعات عمل العيادة) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardClinicSchedule"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            app:strokeWidth="1.5dp"
            app:strokeColor="#330D9488"
            app:cardBackgroundColor="@color/surface_dark_elevated">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <FrameLayout
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_circle_primary_soft">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_clock_outline"
                            app:tint="#0A5C5F" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="مواعيد وساعات عمل العيادة"
                            android:textColor="@color/on_surface_dark"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvSecScheduleStatusBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="تحديد قالب الدوام اليومي/الأسبوعي أو 24 ساعة"
                            android:textColor="@color/brand_primary"
                            android:textSize="12sp"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="تعديل ❯"
                        android:textColor="@color/brand_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvSecScheduleDetails"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="انقر لضبط أوقات فتح وإغلاق العيادة وتطبيقها تلقائياً وإظهارها للمرضى."
                    android:textColor="@color/on_surface_dark_tertiary"
                    android:textSize="12sp"
                    android:layout_marginTop="10dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 3rd Card: Pending Doctors Approval Section (طلبات انضمام الأطباء للعيادة) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardPendingDoctorsSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            app:strokeWidth="1.5dp"
            app:strokeColor="#330D9488"
            app:cardBackgroundColor="@color/surface_dark_elevated">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_circle_primary_soft"
                        android:gravity="center"
                        android:text="🩺"
                        android:textSize="22sp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="طلبات انضمام الأطباء للعيادة"
                            android:textColor="@color/on_surface_dark"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvSecPendingBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="أطباء سجلوا واختاروا عيادتكم بانتظار الاعتماد"
                            android:textColor="@color/on_surface_dark_tertiary"
                            android:textSize="12sp"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvPendingCountBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:background="@drawable/bg_status_accepted"
                        android:textColor="@color/brand_primary"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:text="0 طلب" />
                </LinearLayout>

                <!-- Dynamic container for pending doctors -->
                <LinearLayout
                    android:id="@+id/layoutPendingDoctorsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="12dp" />

                <TextView
                    android:id="@+id/tvNoPendingDoctors"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="لا توجد طلبات انضمام جديدة للأطباء حالياً 🩺"
                    android:textColor="@color/on_surface_dark_tertiary"
                    android:textSize="13sp"
                    android:gravity="center"
                    android:padding="12dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>


        <!-- 💰 Financial Revenue & Commission Card (العائد المالي وحجوزات الأطباء بعد خصم عمولة المنصة) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardClinicFinancials"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            app:strokeWidth="1.5dp"
            app:strokeColor="#330D9488"
            app:cardBackgroundColor="@color/surface_dark_elevated">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <FrameLayout
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_circle_primary_soft">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="💰"
                            android:textSize="22sp" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="عائد وإيرادات حجوزات العيادة"
                            android:textColor="@color/on_surface_dark"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvSecCommissionNotice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="عمولة المنصة: 10% (للاطلاع فقط وغير قابلة للتعديل)"
                            android:textColor="@color/on_surface_dark_tertiary"
                            android:textSize="12sp"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvSecTotalNetRevenueBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:background="@drawable/bg_status_accepted"
                        android:textColor="@color/brand_primary"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:text="0 ر.ي" />
                </LinearLayout>

                <!-- 📅 Financial Date / Range Filter Chips -->
                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupFinancialRange"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:singleSelection="true"
                    app:selectionRequired="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipFinAll"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="الكل"
                        android:textSize="12sp" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipFinToday"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="اليوم"
                        android:textSize="12sp" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipFinWeek"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="هذا الأسبوع"
                        android:textSize="12sp" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipFinMonth"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="هذا الشهر"
                        android:textSize="12sp" />
                </com.google.android.material.chip.ChipGroup>

                <!-- Summary Overview in 2 columns: Total Bookings & Net Revenue -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="14dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:background="@drawable/bg_card_outlined"
                        android:padding="12dp"
                        android:layout_marginEnd="6dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="إجمالي الحجوزات"
                            android:textColor="@color/on_surface_dark_tertiary"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tvSecTotalApptCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 حجز"
                            android:textColor="@color/on_surface_dark"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.2"
                        android:orientation="vertical"
                        android:background="@drawable/bg_card_outlined"
                        android:padding="12dp"
                        android:layout_marginStart="6dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="صافي العائد للعيادة"
                            android:textColor="@color/brand_primary"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvSecTotalNetRevenue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 ر.ي"
                            android:textColor="@color/brand_primary"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Subtitle for doctor breakdown -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="تفاصيل العائد والحجوزات لكل دكتور بالعيادة (بعد خصم العمولة):"
                    android:textColor="@color/on_surface_dark_secondary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="6dp" />

                <!-- Dynamic container for doctor financial cards -->
                <LinearLayout
                    android:id="@+id/layoutDoctorsFinancialContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/tvNoDoctorsFinancial"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="لا توجد بيانات مالية متوفرة حالياً"
                    android:textColor="@color/on_surface_dark_tertiary"
                    android:textSize="12sp"
                    android:gravity="center"
                    android:padding="8dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
