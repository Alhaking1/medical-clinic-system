<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_screen">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingHorizontal="28dp"
            android:paddingVertical="48dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="110dp"
                android:layout_height="110dp"
                app:cardCornerRadius="32dp"
                app:cardElevation="10dp"
                app:strokeWidth="2dp"
                app:strokeColor="#33F59E0B"
                app:cardBackgroundColor="@color/surface_dark_elevated"
                android:layout_marginBottom="28dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="⏳"
                    android:textSize="50sp" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pending_approval_title"
                android:textColor="@color/on_surface_dark"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pending_approval_desc"
                android:textColor="@color/on_surface_dark_tertiary"
                android:textSize="14sp"
                android:textAlignment="center"
                android:lineSpacingExtra="5dp"
                android:layout_marginBottom="36dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCheckApproval"
                style="@style/Widget.MedicalClinicStaff.PrimaryButton"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:text="@string/check_status"
                android:layout_marginBottom="14dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogout"
                style="@style/Widget.MedicalClinicStaff.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:text="@string/logout" />

            <ProgressBar
                android:id="@+id/pbApproval"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:visibility="gone"
                android:indeterminateTint="@color/brand_primary"
                android:layout_marginTop="20dp" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
