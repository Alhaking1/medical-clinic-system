<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="20dp"
    app:cardElevation="4dp"
    app:strokeWidth="1.5dp"
    app:strokeColor="@color/divider"
    app:cardBackgroundColor="@color/surface_dark_elevated"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top info row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Queue Number Badge -->
            <TextView
                android:id="@+id/tvQueueNumber"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_circle_staff_teal"
                android:textColor="@color/white"
                android:textSize="17sp"
                android:textStyle="bold"
                android:gravity="center"
                android:elevation="2dp"
                android:text="#1" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="14dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvPatientName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="اسم المريض"
                        android:textColor="@color/on_surface_dark"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvStaffGoldenBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="👑 ذهبي"
                        android:textColor="@color/banner_warning_text"
                        android:background="@color/banner_warning_bg"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:layout_marginStart="6dp"
                        android:visibility="gone" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvPatientPhone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="770000000"
                    android:textColor="@color/on_surface_dark_tertiary"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- Status Badge -->
            <TextView
                android:id="@+id/tvQueueStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:background="@drawable/bg_status_pending"
                android:textColor="@color/status_waiting"
                android:textSize="12sp"
                android:textStyle="bold"
                android:text="قيد الانتظار" />
        </LinearLayout>

        <!-- Divider line -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider"
            android:layout_marginVertical="12dp" />

        <!-- Booking details & Action buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvBookingCode"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="كود: #"
                android:textColor="@color/on_surface_dark_disabled"
                android:textSize="12sp" />

            <!-- Action: Write Prescription -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnWritePrescription"
                style="@style/Widget.MedicalClinicStaff.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:textSize="12sp"
                android:text="كتابة روشتة 📄"
                android:layout_marginEnd="6dp"
                android:visibility="gone" />

            <!-- Action: Start Consultation -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStartConsultation"
                style="@style/Widget.MedicalClinicStaff.PrimaryButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:textSize="13sp"
                android:text="@string/start_consultation"
                android:visibility="gone" />

            <!-- Action: Finish Consultation -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFinishConsultation"
                style="@style/Widget.MedicalClinicStaff.PrimaryButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:textSize="13sp"
                android:text="@string/finish_consultation"
                android:visibility="gone" />

            <!-- Action: Cancel / Absent -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelVisit"
                style="@style/Widget.MedicalClinicStaff.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:textSize="13sp"
                android:text="@string/mark_absent"
                android:layout_marginStart="8dp"
                android:visibility="gone" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
