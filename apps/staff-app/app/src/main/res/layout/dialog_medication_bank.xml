<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:maxHeight="500dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="بنك الأدوية المفضلة ⭐💊"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/brand_primary"
        android:layout_marginBottom="6dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="اختر دواء لإضافته مباشرة للروشتة بنقرة واحدة:"
        android:textSize="13sp"
        android:textColor="@color/on_surface_dark_secondary"
        android:layout_marginBottom="12dp" />

    <!-- شريط البحث -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilSearchMedBank"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:boxStrokeColor="@color/brand_primary"
        app:startIconDrawable="@android:drawable/ic_menu_search">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etSearchMedBank"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="بحث بالاسم أو المادة الفعالة..."
            android:textSize="14sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <ProgressBar
        android:id="@+id/pbLoadingBank"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginVertical="16dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvEmptyBank"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="20dp"
        android:gravity="center"
        android:text="لا توجد أدوية محفوظة في البنك حتى الآن.\nيمكنك إضافة أدوية للبنك أثناء كتابة الروشتة."
        android:textColor="@color/on_surface_dark_disabled"
        android:textSize="13sp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMedBank"
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:layout_marginBottom="16dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCloseBank"
        style="@style/Widget.MedicalClinicStaff.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:text="إغلاق" />

</LinearLayout>
