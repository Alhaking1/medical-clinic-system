<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/surface_dark">

    <!-- Header / Top Bar -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardElevation="3dp"
        app:cardCornerRadius="0dp"
        app:cardBackgroundColor="@color/surface_dark_elevated">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="16dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/on_surface_dark"
                android:contentDescription="رجوع" />

            <FrameLayout
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_circle_primary_soft">

                <TextView
                    android:id="@+id/tvAvatarInitials"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:textColor="@color/brand_primary_light"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:text="م" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="10dp">

                <TextView
                    android:id="@+id/tvChatTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/on_surface_dark"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="المريض: محمد علي" />

                <TextView
                    android:id="@+id/tvChatSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/on_surface_dark_secondary"
                    android:textSize="12sp"
                    tools:text="محادثة مباشرة مع المريض" />
            </LinearLayout>

            <!-- Online Dot -->
            <View
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@drawable/bg_circle_primary_soft"
                android:backgroundTint="#10B981" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Notice Banner -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/banner_warning_bg"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚠️"
            android:textSize="14sp"
            android:layout_marginEnd="8dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/banner_warning_text"
            android:textSize="11sp"
            android:lineSpacingExtra="2dp"
            android:text="تنبيه: يُمنع إرسال أرقام الهواتف أو كتابة الأرقام بالحروف أو وسائل التواصل في المحادثة لضمان الخصوصية وأمان الخدمة." />
    </LinearLayout>


    <!-- Chat Retention Notice Banner -->
    <LinearLayout
        android:id="@+id/layoutRetentionNotice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#ECFDF5"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔒"
            android:textSize="12sp"
            android:layout_marginEnd="6dp" />

        <TextView
            android:id="@+id/tvRetentionNotice"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#047857"
            android:textSize="11sp"
            android:text="سجل المحادثات محفوظ بشكل دائم للأبد في التطبيق" />
    </LinearLayout>

    <!-- Inline Filter Warning (Shown dynamically if input violates filter) -->
    <LinearLayout
        android:id="@+id/layoutFilterWarning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/danger_soft"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🚫"
            android:textSize="14sp"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/tvFilterWarning"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#991B1B"
            android:textSize="11sp"
            android:textStyle="bold"
            tools:text="الرسالة تحتوي على رقم أو كلمة محظورة" />
    </LinearLayout>

    <!-- Chat Messages List -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvMessages"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="8dp"
            android:paddingBottom="8dp" />

        <ProgressBar
            android:id="@+id/pbLoading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvEmptyState"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="لا توجد رسائل سابقة. ابدأ المحادثة الآن!"
            android:textColor="@color/on_surface_dark_tertiary"
            android:textSize="14sp"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Input Box Bar -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardElevation="6dp"
        app:cardCornerRadius="0dp"
        app:cardBackgroundColor="@color/surface_dark_elevated">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <EditText
                android:id="@+id/etMessage"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="44dp"
                android:maxLines="4"
                android:background="@drawable/bg_glass_card"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:hint="اكتب ردك الطبي هنا..."
                android:textColor="@color/on_surface_dark"
                android:textColorHint="@color/on_surface_dark_disabled"
                android:textSize="14sp"
                android:inputType="textMultiLine|textCapSentences" />

            <FrameLayout
                android:id="@+id/btnSend"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_button_3d_primary"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_send"
                    app:tint="#FFFFFF"
                    android:contentDescription="إرسال" />
            </FrameLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

</LinearLayout>
