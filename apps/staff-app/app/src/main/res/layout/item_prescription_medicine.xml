<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/divider"
    app:cardBackgroundColor="@color/surface_dark_elevated"
    android:layout_marginBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvMedicationIndex"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_circle_primary"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textSize="12sp"
                android:gravity="center"
                android:text="1" />

            <TextView
                android:id="@+id/tvMedicationName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/on_surface_dark"
                android:text="اسم الدواء" />

            <ImageButton
                android:id="@+id/btnRemoveMedication"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_delete"
                app:tint="@color/brand_danger"
                android:contentDescription="حذف الدواء" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/tvMedicationDosage"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="12sp"
                android:textColor="@color/on_surface_dark_secondary"
                android:text="الجرعة: 500mg" />

            <TextView
                android:id="@+id/tvMedicationFrequency"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="12sp"
                android:textColor="@color/on_surface_dark_secondary"
                android:text="التكرار: مرتين يومياً" />

            <TextView
                android:id="@+id/tvMedicationDuration"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="12sp"
                android:textColor="@color/on_surface_dark_secondary"
                android:text="المدة: 5 أيام" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvMedicationInstructions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textSize="11sp"
            android:textColor="@color/on_surface_dark_tertiary"
            android:text="تعليمات: بعد الأكل"
            android:visibility="gone" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
