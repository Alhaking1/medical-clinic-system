<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- ═══════════════════════════════════════════ -->
    <!-- Staff Base Theme (Night Mode)               -->
    <!-- ═══════════════════════════════════════════ -->
    <style name="Theme.MedicalClinicStaff" parent="Theme.Material3.Dark.NoActionBar">
        <!-- Primary Brand -->
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorOnPrimary">#0B0F17</item>
        <item name="colorPrimaryContainer">@color/brand_primary_soft</item>
        <item name="colorOnPrimaryContainer">@color/brand_primary_light</item>

        <!-- Secondary Brand -->
        <item name="colorSecondary">@color/brand_secondary</item>
        <item name="colorOnSecondary">#0B0F17</item>
        <item name="colorSecondaryContainer">@color/brand_secondary_soft</item>
        <item name="colorOnSecondaryContainer">@color/brand_success</item>

        <!-- Error -->
        <item name="colorError">@color/brand_danger</item>
        <item name="colorOnError">#0B0F17</item>

        <!-- Background & Surface -->
        <item name="android:colorBackground">@color/surface_dark</item>
        <item name="colorOnBackground">@color/on_surface_dark</item>
        <item name="colorSurface">@color/surface_dark_elevated</item>
        <item name="colorOnSurface">@color/on_surface_dark</item>
        <item name="colorSurfaceVariant">@color/surface_deep</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_dark_secondary</item>
        <item name="colorOutline">@color/divider</item>

        <!-- System Bars (Night) -->
        <item name="android:statusBarColor">@color/surface_dark</item>
        <item name="android:navigationBarColor">@color/surface_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>

        <item name="android:fontFamily">sans-serif</item>
            <item name="android:windowAnimationStyle">@style/Animation.MedicalClinic.Activity</item>
    </style>

    <!-- ═══════════════════════════════════════════ -->
    <!-- Splash Theme (Night)                        -->
    <!-- ═══════════════════════════════════════════ -->
    <style name="Theme.MedicalClinicStaff.Splash" parent="Theme.MedicalClinicStaff">
        <item name="android:windowBackground">@color/surface_dark</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

</resources>
