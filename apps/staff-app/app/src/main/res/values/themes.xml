<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- ═══════════════════════════════════════════ -->
    <!-- Base Theme (Material 3 Medical Staff Luxury 3D) -->
    <!-- ═══════════════════════════════════════════ -->
    <style name="Theme.MedicalClinicStaff" parent="Theme.Material3.Light.NoActionBar">
        <!-- Primary -->
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">@color/brand_primary_soft</item>
        <item name="colorOnPrimaryContainer">@color/brand_primary_dark</item>

        <!-- Secondary -->
        <item name="colorSecondary">@color/brand_accent</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="colorSecondaryContainer">@color/brand_secondary_soft</item>
        <item name="colorOnSecondaryContainer">@color/brand_secondary_dark</item>

        <!-- Error -->
        <item name="colorError">@color/brand_danger</item>
        <item name="colorOnError">#FFFFFF</item>

        <!-- Background & Surface -->
        <item name="android:colorBackground">@color/surface_dark</item>
        <item name="colorOnBackground">@color/on_surface_dark</item>
        <item name="colorSurface">@color/surface_dark_elevated</item>
        <item name="colorOnSurface">@color/on_surface_dark</item>
        <item name="colorSurfaceVariant">@color/surface_deep</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_dark_secondary</item>
        <item name="colorOutline">@color/divider</item>

        <!-- Status & Navigation Bars -->
        <item name="android:statusBarColor">@color/surface_dark</item>
        <item name="android:navigationBarColor">@color/surface_dark</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>

        <item name="android:fontFamily">sans-serif</item>
            <item name="android:windowAnimationStyle">@style/Animation.MedicalClinic.Activity</item>
    </style>

    <!-- Splash Theme -->
    <style name="Theme.MedicalClinicStaff.Splash" parent="Theme.MedicalClinicStaff">
        <item name="android:windowBackground">@color/surface_dark</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <!-- 3D Luxury Button Styles -->
    <style name="Widget.MedicalClinicStaff.PrimaryButton" parent="Widget.Material3.Button">
        <item name="android:minHeight">56dp</item>
        <item name="cornerRadius">18dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="backgroundTint">@color/brand_primary</item>
        <item name="android:elevation">6dp</item>
    </style>

    <style name="Widget.MedicalClinicStaff.SecondaryButton" parent="Widget.Material3.Button.TonalButton">
        <item name="android:minHeight">56dp</item>
        <item name="cornerRadius">18dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/brand_primary</item>
        <item name="backgroundTint">@color/brand_primary_soft</item>
    </style>

    <style name="Widget.MedicalClinicStaff.OutlinedButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">56dp</item>
        <item name="cornerRadius">18dp</item>
        <item name="android:textSize">16sp</item>
        <item name="strokeColor">@color/divider</item>
        <item name="strokeWidth">1.5dp</item>
    </style>

</resources>
