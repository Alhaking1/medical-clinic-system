# ================================================================
# Medical Clinic System - Environment Configuration Template
# ================================================================

# Server Port
PORT=8080

# Environment Mode (development | production | test)
NODE_ENV=development

# JWT Secret Keys (Must be replaced with a secure 256-bit random key in production)
JWT_SECRET=medical-booking-secret-key-2026-change-in-production
JWT_EXPIRES_IN=7d

# Database & File Storage Paths
DATABASE_PATH=./data/medical.db
UPLOAD_PATH=./uploads

# Test Server Configuration
TEST_BASE_URL=http://localhost:8080
